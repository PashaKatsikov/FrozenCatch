<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme drawn while the process is starting (before Flutter's first
         frame). Uses a solid brand colour so there is NO white flash and
         no framed launcher-icon behind the splash — see
         gray_part_pitfalls.md §16 (adaptive-icon flash). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Theme applied once the process is running (behind the Flutter UI). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
        <!-- Report the display-cutout inset even while system bars are
             hidden so the WebView / router screens can keep a safe zone
             around the camera notch — this is what wires the SafeArea in
             ContentStage / ArcticRouter to actually receive an inset in
             landscape. -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
