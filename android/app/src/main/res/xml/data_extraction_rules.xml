<?xml version="1.0" encoding="utf-8"?>
<!-- Disallow all backup / device-transfer flows. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root"/>
        <exclude domain="sharedpref"/>
        <exclude domain="database"/>
        <exclude domain="file"/>
    </device-transfer>
</data-extraction-rules>
